# Copy to .env.local only when implementing provider adapters. Never commit real values.
# Public browser configuration is visible to users; no secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SPACETIMEDB_URI=
NEXT_PUBLIC_SPACETIMEDB_MODULE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server/worker only
CLERK_SECRET_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
FACTORY_API_KEY=
KINETIC_WORKER_URL=
KINETIC_WORKER_AUTH_TOKEN=
# Optional AI overrides (defaults: claude-opus-5-5, droid on PATH, 8000 ms)
KINETIC_CLAUDE_MODEL=
KINETIC_DROID_PATH=
KINETIC_DROID_TIMEOUT_MS=
# Use separate verified deployment credentials locally; never expose module admin keys.
# Vault keys are generated/derived per the Cyber design, never placed in environment files.
