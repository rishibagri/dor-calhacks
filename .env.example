# Copy to .env.local only when implementing provider adapters. Never commit real values.
# Public browser configuration is visible to users; no secrets in NEXT_PUBLIC_*.
# Local: ws://localhost:3000 after `spacetime start`; hosted: wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_URI=
NEXT_PUBLIC_SPACETIMEDB_MODULE=dor
# D045 transition-first: Discover/Events are shown by default; "off" hides them (server flag stays authoritative)
NEXT_PUBLIC_DOR_DISCOVERY=on
# Discover labels cards as synthetic test data unless this is exactly "false" (real opted-in people only)
NEXT_PUBLIC_DISCOVERY_SYNTHETIC=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk JWT template whose token SpacetimeDB accepts (issuer must be in the module allowlist).
NEXT_PUBLIC_CLERK_SPACETIME_JWT_TEMPLATE=spacetimedb
# Module bootstrap (scripts/bootstrap-module.ts): not secrets, but server-side only
# Clerk Frontend API origin, e.g. https://<instance>.clerk.accounts.dev (no trailing slash)
DOR_CLERK_ISSUER=
# Must equal the `aud` claim in the Clerk JWT template named above
DOR_AUTH_AUDIENCE=
# Server/worker only
CLERK_SECRET_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
FACTORY_API_KEY=
DOR_WORKER_URL=
DOR_WORKER_AUTH_TOKEN=
# Worker's own SpacetimeDB connection (worker/src/main.ts); identity must be allow-listed via set_worker_identity
DOR_SPACETIME_URI=
DOR_SPACETIME_MODULE=dor
DOR_SPACETIME_WORKER_TOKEN=
# Optional AI overrides (defaults: claude-opus-5-5 reflection, claude-haiku-5-5 Droid, droid on PATH, 8000 ms)
DOR_CLAUDE_MODEL=
DOR_DROID_MODEL=
DOR_DROID_PATH=
DOR_DROID_TIMEOUT_MS=
# sdk (default; needs FACTORY_API_KEY) or cli (droid exec, works with a local CLI login)
DOR_DROID_TRANSPORT=
# Use separate verified deployment credentials locally; never expose module admin keys.
# Vault keys are generated/derived per the Cyber design, never placed in environment files.

# CS-owned public activity discovery (planned; configure only after source/cost review)
# Server-only; never prefix this token with NEXT_PUBLIC_ or put it in URL logs.
APIFY_API_TOKEN=
# Reviewed Apify task that holds the regional source configuration (scripts/ingest-catalogue.ts)
APIFY_TASK_ID=
# Choose verified Actor-specific input/output, timeout/item/cost caps before real runs.
# D045 Apify adapter (src/server/discovery). Actor + caps are fixed config; --fetch is opt-in and costs credits.
# APIFY_ACTOR_ID=tortuga/luma-scraper   (see docs/features/APIFY_SOURCE.md)
# APIFY_SOURCE=luma                     (luma | meetup)
# APIFY_MAX_ITEMS=25                    (<= 50)
# APIFY_TOPICS=board-games,live-music
# APIFY_WINDOW_DAYS=14
# APIFY_TIMEOUT_MS=90000
