{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "viewerRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidateRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "viewerPublicationVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "candidatePublicationVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "shared_interest",
        "same_event"
      ]
    },
    "sharedTags": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      }
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "openerId": {
      "type": "string",
      "enum": [
        "suggest_shared_interest",
        "suggest_event_together"
      ]
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "decidedBy": {
      "type": "string",
      "enum": [
        "deterministic",
        "agent",
        "fixed_template"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "proposalId",
    "requestId",
    "viewerRef",
    "candidateRef",
    "viewerPublicationVersion",
    "candidatePublicationVersion",
    "reasonCode",
    "sharedTags",
    "openerId",
    "revision",
    "createdAt",
    "expiresAt",
    "decidedBy"
  ],
  "additionalProperties": false
}
