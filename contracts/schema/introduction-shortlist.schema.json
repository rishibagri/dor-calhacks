{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "viewerRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "viewerPublicationVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "candidates": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cardRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "publicationVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "overlapTags": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,31}$"
            }
          },
          "sharedEventIds": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "required": [
          "cardRef",
          "publicationVersion",
          "overlapTags",
          "sharedEventIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "viewerRef",
    "viewerPublicationVersion",
    "candidates"
  ],
  "additionalProperties": false
}
