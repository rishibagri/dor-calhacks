{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "outcome": {
      "type": "string",
      "enum": [
        "proposed",
        "no_shared_event",
        "source_stale",
        "not_current",
        "no_fit",
        "proposer_failed_fallback",
        "proposer_failed_no_suggestion"
      ]
    },
    "mutualEvents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "usableEvents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "modelCalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "decidedBy": {
      "type": "string",
      "enum": [
        "none",
        "deterministic",
        "agent",
        "fixed_template"
      ]
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "outcome",
    "mutualEvents",
    "usableEvents",
    "rounds",
    "modelCalls",
    "decidedBy"
  ],
  "additionalProperties": false
}
