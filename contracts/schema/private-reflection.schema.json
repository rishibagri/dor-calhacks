{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "reflection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "candidate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "supportMode": {
              "type": "string",
              "enum": [
                "short_call",
                "encouraging_note",
                "shared_activity"
              ]
            },
            "availability": {
              "type": "string",
              "enum": [
                "today",
                "this_week",
                "no_preference"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "assessment": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "wants_connection",
            "unclear",
            "wants_space"
          ]
        },
        "risk": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "interpersonal_conflict",
            "urgent_support"
          ]
        },
        "mentionedNames": {
          "default": [],
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "excludedNames": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "preferredNames": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      },
      "required": [
        "intent",
        "risk",
        "mentionedNames",
        "excludedNames",
        "preferredNames"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "reflection",
    "candidate"
  ],
  "additionalProperties": false
}
