{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "provider": {
      "type": "string",
      "const": "cartesia"
    },
    "accessToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sttModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sttEncoding": {
      "type": "string",
      "const": "pcm_s16le"
    },
    "sttSampleRate": {
      "type": "number",
      "const": 16000
    },
    "ttsModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ttsVoiceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schemaVersion",
    "provider",
    "accessToken",
    "expiresAt",
    "apiVersion",
    "sttModel",
    "sttEncoding",
    "sttSampleRate",
    "ttsModel",
    "ttsVoiceId"
  ],
  "additionalProperties": false
}
