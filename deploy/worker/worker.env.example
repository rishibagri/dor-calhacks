# Copy to worker.env (git-ignored by deploy/worker/.gitignore). Placeholders only.
# Database: the allow-listed worker identity's token (set_worker_identity), never a user's.
DOR_SPACETIME_URI=wss://maincloud.spacetimedb.com
DOR_SPACETIME_MODULE=dor
DOR_SPACETIME_WORKER_TOKEN=
# Bearer token for POST /jobs; at least 32 characters (openssl rand -hex 32).
DOR_WORKER_AUTH_TOKEN=
# off = no model calls (default in the image). sdk needs FACTORY_API_KEY and an owner cost decision.
DOR_DROID_TRANSPORT=off
# FACTORY_API_KEY=
DOR_WORKER_INTRODUCTIONS=deterministic
DOR_WORKER_SWEEP_MS=15000
DOR_WORKER_MAX_OFFLINE_MS=120000
