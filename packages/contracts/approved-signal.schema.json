{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kinetic:approved-signal:v2",
  "title": "ApprovedSignal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "signalId",
    "pairId",
    "senderId",
    "recipientId",
    "purpose",
    "consentVersion",
    "expiresAt",
    "recipientPolicyId",
    "recipientPolicyVersion",
    "presetAssignmentVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "signalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pairId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "senderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recipientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "purpose": {
      "const": "support_nudge"
    },
    "supportMode": {
      "enum": [
        "short_call",
        "encouraging_note",
        "shared_activity"
      ]
    },
    "availability": {
      "enum": [
        "today",
        "this_week",
        "no_preference"
      ]
    },
    "consentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "recipientPolicyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recipientPolicyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "presetAssignmentVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "anyOf": [
    {
      "required": [
        "supportMode"
      ]
    },
    {
      "required": [
        "availability"
      ]
    }
  ]
}
