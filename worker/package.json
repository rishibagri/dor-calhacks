{
  "name": "@dor/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.bindings.json && node scripts/fix-bindings-imports.mjs && tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "live": "node scripts/live-droid.mjs",
    "start": "node dist/main.js",
    "test:integration": "vitest run --config integration/vitest.config.ts"
  },
  "dependencies": {
    "@dor/agents": "0.1.0",
    "@dor/contracts": "0.1.0",
    "@factory/droid-sdk": "0.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "spacetimedb": "2.13.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0"
  }
}
